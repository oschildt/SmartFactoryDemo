# Use UTF-8 for application responses.

AddDefaultCharset UTF-8
AddCharset UTF-8 .html

AddType 'text/html; charset=UTF-8' html

# Prevent content negotiation from resolving API routes to similarly named files.
Options -MultiViews

<IfModule rewrite_module>
    RewriteEngine On

    # Derive the URL prefix from the requested route, including any Alias prefix.
    # This also supports a directory served both at the domain root and via Alias.
    RewriteCond $0#%{REQUEST_URI} ^(.+)#(.*)\1$
    RewriteRule ^(api|xmlapi)/.*$ %2$1/index.php [END]
</IfModule>
